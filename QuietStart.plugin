http-response ^https?://cards\.iqiyi\.com/views_plt/3\.0/player_tabs_v2\? max-size=-1, requires-body=true, script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/cntv.js, tag=iqiyi
